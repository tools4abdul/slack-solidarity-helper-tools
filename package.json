{
	"name": "slack-solidarity-helper-tools",
	"version": "1.0.0",
	"description": "Tools for tracking volunteer recruitment, management, and engagement via Slack",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "svelte-check --tsconfig ./tsconfig.json && npm run check:migrator",
		"check:migrator": "tsc -p tsconfig.migrator.json",
		"prepare": "git config core.hooksPath .githooks || true && svelte-kit sync",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "node bin/seed-dev-db.js",
		"van:check": "tsx --env-file=.env.local scripts/van-check.ts",
		"van:sync": "tsx --env-file=.env.local scripts/van-sync-once.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@libsql/client": "^0.17.2",
		"@slack/web-api": "^7.8.0",
		"bits-ui": "^2.18.1",
		"drizzle-orm": "^0.45.2",
		"layerchart": "^2.0.0",
		"libphonenumber-js": "^1.12.41"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-geo": "^3.1.1",
		"@types/node": "^20.0.0",
		"d3-geo": "^3.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.7.3",
		"tsx": "^4.0.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.0.5",
		"vitest": "^4.1.2"
	}
}
