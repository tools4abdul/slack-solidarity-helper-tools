# Bot token from your Slack App
# Requires bot scopes: chat:write, im:write, channels:manage, groups:write, users:read, users:read.email,
# and files:read (for the door-knock snapshot's "Conversation Codes" canvas)
# Found at: api.slack.com/apps > your app > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# OAuth credentials for Sign in with Slack (used to protect /pending)
# Found at: api.slack.com/apps > your app > Basic Information > App Credentials
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret

# Signing secret used to verify requests from Slack Events API
# Found at: api.slack.com/apps > your app > Basic Information > App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# Comma-separated list of Slack user IDs allowed to access /pending and /settings.
# Fallback/seed for the DB-backed allowed_slack_users list — once that table has
# rows they take precedence.
# Find a user's ID: open their profile in Slack > ... menu > Copy member ID
SLACK_ALLOWED_USER_IDS=U012AB3CD,U012AB3CE

# Optional: Slack user ID that is ALWAYS granted admin access, even if the
# allowed list in the database is emptied or mis-edited. Lockout escape hatch.
SLACK_SUPERUSER_ID=U012AB3CD

# The Slack channel ID (not name) to post volunteer notifications to
# Right-click the channel in Slack > View channel details > scroll to bottom
SLACK_TRACKING_CHANNEL_ID=C012AB3CD

# Slack channel ID for the weekly chapter-growth shoutout post
# (kept separate from SLACK_TRACKING_CHANNEL_ID so growth posts can live in a more public channel)
SLACK_GROWTH_REPORT_CHANNEL_ID=C012AB3CD

# Comma-separated list of Solidarity chapter IDs to exclude from reports —
# both the weekly growth leaderboard and the dashboard charts (e.g. test
# chapters, internal-only chapters). Leave empty to include all.
REPORT_EXCLUDED_CHAPTER_IDS=123,456

# Power-law exponent for the weekly growth ranking score:
#   score = newJoins / (existing + 1) ^ alpha
# 1.0 = pure relative growth (small chapters dominate); 0.7 = small chapters
# usually still win but large ones can compete; 0.5 = square-root denominator
# (large chapters favored). Default 0.7 if unset.
SLACK_GROWTH_REPORT_RANKING_ALPHA=0.7

# Turso database credentials
# Found at: app.turso.tech > your database > Connect
# For local development use: TURSO_DATABASE_URL=file:local.db (TURSO_AUTH_TOKEN not required)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Secret appended to the solidarity.tech webhook URL as ?secret=<value>
WEBHOOK_SECRET=your-webhook-secret-here

# solidarity.tech API bearer token for member lookups
# Found at: solidarity.tech > Settings > API
SOLIDARITY_API_TOKEN=your-solidarity-api-token-here

# Shared secret for internal cron-triggered endpoints (e.g. /api/internal/solidarity-snapshot).
# Callers pass it as ?key=<value>. Generate with `openssl rand -hex 32` or similar.
INTERNAL_CRON_SECRET=your-internal-cron-secret-here

# JSON array mapping solidarity.tech chapter IDs to Slack channel IDs and display names.
# When a new member joins Slack, their chapters are looked up and they are
# automatically invited to the matching channels and sent a welcome DM.
# Fallback for the /settings chapter↔channel editor: used while the DB table is
# empty, and copied into it before its first interactive edit.
# Example: [{"chapterId":123,"channelId":"C012AB3CD","name":"Washtenaw County"},{"chapterId":456,"channelId":"C987XY6Z","name":"Wayne County"}]
SOLIDARITY_CHAPTER_CHANNEL_MAP=[]

# Openfield door-knocking is retired. OPENFIELD_BASE_URL / _USERNAME /
# _PASSWORD, DOOR_KNOCK_CHANNEL_ID and DOOR_KNOCK_PROVIDER are no longer read by
# anything — the canvassing board is built from the VAN turf checkout ledger
# (see the VAN section below). Existing deployments can delete those secrets.

# Public URL of this app (used to build the Slack OAuth redirect URI)
APP_URL=https://your-app.fly.dev

# Required by SvelteKit's adapter-node for CSRF protection — must match APP_URL
ORIGIN=https://your-app.fly.dev

# Port for the HTTP server (default: 3000)
PORT=3000

# --- Local development only ---
# Set to your Slack user ID to bypass Slack OAuth when running locally.
# When set, visiting /pending auto-creates a session without hitting Slack.
# The SLACK_* OAuth vars and APP_URL are not required when this is set.
# DEV_SLACK_USER_ID=U012AB3CD

# --- Mobilize sync (events out, attendees back) -------------------------------
# Details for creating events in mobilize
MOBILIZE_ORG_SLUG=senatecandidate
MOBILIZE_ORG_ID=12345
MOBILIZE_API_KEY=xxxxxxxxxxxxxxxxxxx

# Blast-radius guard for the nightly event sync: if one run's plan wants more
# than this many NEW Mobilize events, it creates nothing and alerts instead.
# A flood means dedup broke, and created events are publicly visible. Default 25.
MOBILIZE_SYNC_MAX_CREATES=25

# --- Attendee sync (Mobilize signups -> Solidarity RSVPs) ---------------------
# Last-resort chapter for a new Solidarity profile when the person's zip isn't in
# the derived zip->chapter map AND the event isn't chapter-scoped. Leave unset
# (0) to have those people reported rather than filed under a guess.
SOLIDARITY_DEFAULT_CHAPTER_ID=
# Guard: a run creating more than this many NEW Solidarity profiles stops and
# alerts. A spike almost always means person-matching is failing, and duplicate
# people in the CRM are tedious to unpick. Default 50.
ATTENDEE_SYNC_MAX_NEW_PROFILES=50

# --- VAN integration ----------------------------------------------------------
# the Application Name EveryAction issued — this is the Basic auth *username*
VAN_APP_NAME=
VAN_API_KEY=
VAN_DATABASE_MODE=0  # 0 = My Voters, 1 = My Campaign